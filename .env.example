# Environment Configuration Template
# Copy this to your .env file or set these as Railway variables

# ───────────────────────────────────────────────────────────────────────────
# REQUIRED: Discord Bot
# ───────────────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here
OWNER_ID=your_discord_user_id_here

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: Dashboard/API
# ───────────────────────────────────────────────────────────────────────────
PORT=8080
DASHBOARD_KEY=your_secure_dashboard_key

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: TikBot-style Auto-Detection
# ───────────────────────────────────────────────────────────────────────────
# Space-separated list of domains to auto-detect
TIKBOT_AUTO_DOMAINS=youtube tiktok instagram reddit redd.it
# Domains where bot should NOT post detection messages
TIKBOT_SILENT_DOMAINS=
TIKBOT_STATUS_TEXT=🎙️ voice channel
TIKBOT_VERSION=
TIKBOT_MAX_UPLOAD_MB=50

# ───────────────────────────────────────────────────────────────────────────
# ⭐ NEW: Link Security APIs - Malicious URL Detection
# ───────────────────────────────────────────────────────────────────────────

# Google Safe Browsing API (Recommended)
# Get key: https://console.cloud.google.com/
# Provides: Global malware/phishing detection
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# Kaspersky Klookup API (Optional)
# Get key: https://opentips.kaspersky.com/
# Provides: Advanced threat detection
KASPERSKY_API_KEY=your_kaspersky_api_key_here

# URLhaus API (Enabled by default - NO KEY NEEDED)
# Provides: Community malware database
# Set to false to disable
URLHAUS_ENABLED=true

# ChongLuaDao Vietnamese Anti-Scam Database (NO KEY NEEDED)
# Automatically checked - graceful fallback if offline
# Provides: Vietnam-focused scam detection

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: YouTube Cookie Support (for yt-dlp)
# ───────────────────────────────────────────────────────────────────────────
# Option 1: File path to cookies.txt
# YTDL_COOKIE_FILE=/path/to/cookies.txt

# Option 2: Raw cookie string
# YTDL_COOKIES=your_raw_cookies_here

# Option 3: Base64-encoded cookies (recommended for Railway)
# YTDL_COOKIES_BASE64=base64_encoded_cookies_here

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: Proxy Support
# ───────────────────────────────────────────────────────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080

# ───────────────────────────────────────────────────────────────────────────
# SETUP GUIDE
# ───────────────────────────────────────────────────────────────────────────
# 
# 1. MINIMAL SETUP (Free, local protection only):
#    - Set: DISCORD_TOKEN, GUILD_ID, VOICE_CHANNEL_ID
#    - URLhaus + ChongLuaDao automatically enabled
#
# 2. RECOMMENDED SETUP (Free + Global):
#    - Set: Above + GOOGLE_SAFE_BROWSING_KEY
#    - Get Google key from: https://console.cloud.google.com/
#
# 3. FULL SETUP (All detection methods):
#    - Set: Above + KASPERSKY_API_KEY
#    - Get Kaspersky key from: https://opentips.kaspersky.com/
#
# 4. ON RAILWAY:
#    - Set all variables in Railway Variables panel
#    - No .env file needed (use platform variables)
#    - Restart bot after changing variables
#
# See LINK_SECURITY_SETUP.md for detailed instructions

# ───────────────────────────────────────────────────────────────────────────
# EXAMPLES
# ───────────────────────────────────────────────────────────────────────────
#
# Minimal:
# DISCORD_TOKEN=MTk4NjIyNDgzNzY1MjQ1MDU2.xxx
# GUILD_ID=123456789
# VOICE_CHANNEL_ID=987654321
# OWNER_ID=112233445566
#
# Recommended:
# DISCORD_TOKEN=MTk4NjIyNDgzNzY1MjQ1MDU2.xxx
# GUILD_ID=123456789
# VOICE_CHANNEL_ID=987654321
# OWNER_ID=112233445566
# GOOGLE_SAFE_BROWSING_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxx
#
# Full:
# DISCORD_TOKEN=MTk4NjIyNDgzNzY1MjQ1MDU2.xxx
# GUILD_ID=123456789
# VOICE_CHANNEL_ID=987654321
# OWNER_ID=112233445566
# GOOGLE_SAFE_BROWSING_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxx
# KASPERSKY_API_KEY=ks_live_xxxxxxxxxxxxxxxxxxxxxxxx
# URLHAUS_ENABLED=true
